// Bring-up diagnostic: does the GPU driver gamma-encode what GL writes to a window surface?
cc_test {
    name: "cappu-gl-srgb-test",
    srcs: ["gl_srgb_test.cpp"],
    gtest: false,
    shared_libs: ["libcutils", "libEGL", "libGLESv2", "libui", "libgui", "libutils"],
    static_libs: ["libglTest"],
    cflags: ["-DGL_GLEXT_PROTOTYPES", "-DEGL_EGLEXT_PROTOTYPES", "-Wall", "-Werror"],
}

// Lists the GPU driver's EGL configs and replays the config requests Flutter's
// Impeller renderer makes at start-up (window and pbuffer, with and without MSAA).
cc_test {
    name: "cappu-egl-config-test",
    srcs: ["egl_config_test.c"],
    gtest: false,
    shared_libs: ["libEGL"],
    cflags: ["-Wall", "-Werror"],
}
