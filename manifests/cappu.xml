<?xml version="1.0" encoding="UTF-8"?>
<!-- Xiaomi Mi Pad 3 (cappu) on LineageOS 19.1. Save as .repo/local_manifests/cappu.xml. -->
<manifest>
  <remote name="cappu" fetch="https://github.com/t-chamb/" revision="cappu-lineage-19.1-port" />

  <project path="device/xiaomi/cappu" name="android_device_xiaomi_cappu" remote="cappu" />
  <project path="vendor/xiaomi/cappu" name="android_vendor_xiaomi_cappu" remote="cappu" />
  <project path="kernel/xiaomi/cappu" name="android_kernel_xiaomi_cappu" remote="cappu" />

  <!-- Platform repositories that carry changes for the Android 7 vendor blobs and the 3.18 kernel. -->
  <remove-project name="LineageOS/android_frameworks_av" />
  <project path="frameworks/av" name="android_frameworks_av" remote="cappu" groups="pdk" />
  <remove-project name="LineageOS/android_frameworks_base" />
  <project path="frameworks/base" name="android_frameworks_base" remote="cappu" groups="pdk-cw-fs,pdk-fs" />
  <remove-project name="LineageOS/android_frameworks_native" />
  <project path="frameworks/native" name="android_frameworks_native" remote="cappu" groups="pdk" />
  <remove-project name="LineageOS/android_hardware_interfaces" />
  <project path="hardware/interfaces" name="android_hardware_interfaces" remote="cappu" groups="pdk" />
  <remove-project name="LineageOS/android_lineage-sdk" />
  <project path="lineage-sdk" name="android_lineage-sdk" remote="cappu" />
  <remove-project name="LineageOS/android_packages_apps_LineageParts" />
  <project path="packages/apps/LineageParts" name="android_packages_apps_LineageParts" remote="cappu" />
  <remove-project name="LineageOS/android_packages_apps_Settings" />
  <project path="packages/apps/Settings" name="android_packages_apps_Settings" remote="cappu" groups="pdk-fs" />
  <remove-project name="platform/packages/modules/NetworkStack" />
  <project path="packages/modules/NetworkStack" name="android_packages_modules_NetworkStack" remote="cappu" groups="pdk-cw-fs,pdk-fs" />
  <remove-project name="platform/system/bpf" />
  <project path="system/bpf" name="android_system_bpf" remote="cappu" groups="pdk" />
  <remove-project name="LineageOS/android_system_libhidl" />
  <project path="system/libhidl" name="android_system_libhidl" remote="cappu" groups="pdk" />
  <remove-project name="LineageOS/android_system_netd" />
  <project path="system/netd" name="android_system_netd" remote="cappu" groups="pdk" />
  <remove-project name="LineageOS/android_system_vold" />
  <project path="system/vold" name="android_system_vold" remote="cappu" groups="pdk" />

  <!-- Optional: MindTheGapps for Android 12.1 (branch sigma). Built in when present. -->
  <remote name="gitlab-mtg" fetch="https://gitlab.com/" />
  <project path="vendor/gapps" name="MindTheGapps/vendor_gapps" remote="gitlab-mtg"
           revision="f75a18fd21f0ceaa73b3c2c01bdb257aff976f2f" clone-depth="1" />
</manifest>
