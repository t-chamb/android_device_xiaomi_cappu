######################
# TrustKernel add
/dev/tkcoredrv u:object_r:tkcore_admin_device:s0
/vendor/bin/teed u:object_r:tkcore_exec:s0
/data/tee(/.*)? u:object_r:tkcore_data_file:s0
/vendor/protect_f/tee(/.*)? u:object_r:tkcore_data_file:s0
/vendor/app/t6(/.*)? u:object_r:tkcore_systa_dir:s0
/data/tee/t6(/.*)? u:object_r:tkcore_spta_dir:s0
/data/teec.log u:object_r:tkcore_log_file:s0
/data/tee/tkcore.log u:object_r:tkcore_log_file:s0
/dev/block/platform/mtk-msdc\.0/[0-9]+\.(msdc|MSDC)0/by-name/sdrpmb u:object_r:tkcore_block_device:s0

/data/sCaMAH.dat u:object_r:battery_data_file:s0
/data/fcc.dat u:object_r:battery_data_file:s0
/data/ocv_flag.dat u:object_r:battery_data_file:s0


# Mount points for the MTK partitions mounted from fstab.mt8173 (stock blobs expect them at /)
/nvdata(/.*)?       u:object_r:nvdata_file:s0
/protect_f(/.*)?    u:object_r:protect_f_data_file:s0
/protect_s(/.*)?    u:object_r:protect_s_data_file:s0
/persist(/.*)?      u:object_r:persist_data_file:s0
/cust(/.*)?         u:object_r:rootfs:s0

# Vendor services that otherwise run as init
/(vendor|system/vendor)/bin/pq                                              u:object_r:pq_daemon_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.drm@1\.4-service\.clearkey u:object_r:hal_drm_default_exec:s0
/(vendor|system/vendor)/bin/init\.cappu\.btaddr\.sh                          u:object_r:cappu_btaddr_exec:s0
